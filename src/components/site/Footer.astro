---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-t border-border/40 mt-24">
  <div class="container mx-auto max-w-5xl px-4 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-muted-foreground">
    <p>© {year} — {t('footer.rights')}</p>
    <p>
      {t('footer.builtWith')}
      <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors ml-1">Astro</a>,
      <a href="https://ui.shadcn.com" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors ml-1">shadcn/ui</a> &
      <a href="https://azure.microsoft.com/products/app-service/static" target="_blank" rel="noopener noreferrer" class="hover:text-foreground transition-colors ml-1">Azure SWA</a>
    </p>
  </div>
</footer>
