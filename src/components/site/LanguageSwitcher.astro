---
import { languages } from '@/i18n/ui';
import { getLangFromUrl, localizedPath } from '@/i18n/utils';
import type { Lang } from '@/i18n/ui';

interface Props {
  currentPath?: string;
}

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.props.currentPath ?? Astro.url.pathname;
---

<div class="flex items-center gap-1 text-sm">
  {Object.entries(languages).map(([code, label]) => (
    <a
      href={localizedPath(code as Lang, currentPath.replace(new RegExp(`^/(es|pt)`), ''))}
      class:list={[
        'px-2 py-1 rounded transition-colors hover:text-foreground',
        code === lang
          ? 'font-semibold text-foreground'
          : 'text-muted-foreground hover:bg-accent',
      ]}
      aria-current={code === lang ? 'true' : undefined}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>
