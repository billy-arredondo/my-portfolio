---
import { Card, CardContent, CardHeader } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import StatusBadge from './StatusBadge.astro';
import { getLangFromUrl, useTranslations, localizedPath } from '@/i18n/utils';
import type { ProjectEntry } from '@/lib/projects';
import { getProjectSlug } from '@/lib/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const slug = getProjectSlug(project);
const href = localizedPath(lang, `/projects/${slug}`);
---

<a href={href} class="group block h-full">
  <Card class="h-full transition-colors hover:border-primary/50 hover:bg-accent/20">
    <CardHeader class="pb-3">
      <div class="flex items-start justify-between gap-2 mb-2">
        <StatusBadge status={data.status} />
        <span class="text-xs text-muted-foreground font-mono">{data.year}</span>
      </div>
      <h3 class="font-semibold text-lg leading-tight group-hover:text-primary transition-colors">
        {data.title}
      </h3>
    </CardHeader>
    <CardContent>
      <p class="text-sm text-muted-foreground mb-4 line-clamp-2">{data.description}</p>
      <div class="flex flex-wrap gap-1">
        {data.stack.slice(0, 4).map(tech => (
          <Badge variant="outline" class="text-xs font-mono">{tech}</Badge>
        ))}
        {data.stack.length > 4 && (
          <Badge variant="outline" class="text-xs font-mono">+{data.stack.length - 4}</Badge>
        )}
      </div>
    </CardContent>
  </Card>
</a>
