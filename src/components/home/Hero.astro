---
import { getLangFromUrl, useTranslations, localizedPath } from '@/i18n/utils';
import { Button } from '@/components/ui/button';
import { Download } from 'lucide-react';
import Typewriter from '@/components/home/Typewriter';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const name = 'Billy';
---

<section class="container mx-auto max-w-5xl px-4 pt-24 pb-12 md:pt-32 md:pb-16">
  <div class="max-w-2xl">
    <p class="text-muted-foreground mb-3 font-mono text-sm tracking-widest uppercase">
      {t('hero.greeting')} {name}
    </p>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-tight mb-4">
      <Typewriter
        phrases={[t('hero.tagline'), t('hero.tagline2'), t('hero.tagline3')]}
        client:load
      />
    </h1>
    <p class="text-lg md:text-xl text-muted-foreground mb-8 font-mono">
      {t('hero.subtagline')}
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/billy-arredondo-cv.pdf" download>
        <Button size="lg"><Download aria-hidden="true" />{t('hero.cta.downloadCv')}</Button>
      </a>
      <a href={localizedPath(lang, '/contact')}>
        <Button size="lg" variant="outline">{t('hero.cta.contact')}</Button>
      </a>
    </div>
  </div>
</section>
