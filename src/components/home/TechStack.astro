---
import { DatabaseZap, Network, Workflow, FlaskConical, Layers, Zap, Globe, Braces, Database } from "lucide-react";

const BASE = "https://svgl.app/library";

interface TechItem {
  label: string;
  iconLight?: string;
  iconDark?: string;
  lucideIcon?: typeof DatabaseZap;
}

interface Category {
  name: string;
  items: TechItem[];
}

const categories: Category[] = [
  {
    name: "Backend",
    items: [
      { label: ".NET / C#", lucideIcon: Braces },
      { label: ".NET Core", lucideIcon: Braces },
      { label: ".NET Framework", lucideIcon: Braces },
      { label: "EF Core", lucideIcon: Database },
      { label: "CQRS", lucideIcon: DatabaseZap },
      { label: "Dapper", lucideIcon: Layers },
      { label: "Node.js", iconLight: `${BASE}/nodejs.svg` },
      { label: "Express.js", lucideIcon: Zap },
      { label: "xUnit", lucideIcon: FlaskConical },
      { label: "nUnit", lucideIcon: FlaskConical },
    ],
  },
  {
    name: "Frontend",
    items: [
      {
        label: "React",
        iconLight: `${BASE}/react_light.svg`,
        iconDark: `${BASE}/react_dark.svg`,
      },
      { label: "TypeScript", iconLight: `${BASE}/typescript.svg` },
      {
        label: "Next.js",
        iconLight: `${BASE}/nextjs_light.svg`,
        iconDark: `${BASE}/nextjs_dark.svg`,
      },
      { label: "Vue.js", iconLight: `${BASE}/vue.svg` },
    ],
  },
  {
    name: "Cloud",
    items: [
      { label: "Azure", iconLight: `${BASE}/azure.svg` },
      { label: "Azure Functions", iconLight: `${BASE}/azure.svg` },
      { label: "Azure Service Bus", iconLight: `${BASE}/azure.svg` },
      { label: "Cosmos DB", lucideIcon: Globe },
      { label: "GitHub Actions", iconLight: `${BASE}/github-actions.svg` },
      { label: "Microservices", lucideIcon: Network },
    ],
  },
  {
    name: "Data & Infra",
    items: [
      { label: "SQL Server", iconLight: `${BASE}/sql-server.svg` },
      { label: "PostgreSQL", iconLight: `${BASE}/postgresql.svg` },
      { label: "Redis", iconLight: `${BASE}/redis.svg` },
      { label: "RabbitMQ", lucideIcon: Workflow },
      { label: "Docker", iconLight: `${BASE}/docker.svg` },
    ],
  },
];
---

<section class="container mx-auto max-w-5xl px-4 pb-16">
  <div class="flex flex-col gap-8">
    {
      categories.map((cat) => (
        <div>
          <p class="text-xs font-medium text-muted-foreground uppercase tracking-wider mb-3">
            {cat.name}
          </p>
          <div class="flex flex-wrap gap-2">
            {cat.items.map((item) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-border px-3 py-1 text-sm text-muted-foreground font-mono">
                {item.lucideIcon && (
                  <item.lucideIcon
                    size={16}
                    aria-hidden="true"
                    class="w-4 h-4 shrink-0"
                  />
                )}
                {item.iconLight && (
                  <img
                    src={item.iconLight}
                    alt=""
                    width={16}
                    height={16}
                    aria-hidden="true"
                    class={`w-4 h-4 shrink-0${item.iconDark ? " dark:hidden" : ""}`}
                    style="filter: grayscale(1)"
                  />
                )}
                {item.iconDark && (
                  <img
                    src={item.iconDark}
                    alt=""
                    width={16}
                    height={16}
                    aria-hidden="true"
                    class="w-4 h-4 shrink-0 hidden dark:block"
                    style="filter: grayscale(1)"
                  />
                )}
                {item.label}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
