---
const stack = [
  ".NET / C#",
  "Azure",
  ".NET Core",
  ".NET Framework",
  "React",
  "TypeScript",
  "Microservices",
  "Azure Functions",
  "Azure Service Bus",
  "RabbitMQ",
  "Docker",
  "Entity Framework",
  "SQL Server",
  "CQRS",
  "Redis",
];
---

<section class="container mx-auto max-w-5xl px-4 pb-16">
  <div class="flex flex-wrap gap-2">
    {
      stack.map((tech) => (
        <span class="rounded-full border border-border px-3 py-1 text-sm text-muted-foreground font-mono">
          {tech}
        </span>
      ))
    }
  </div>
</section>
