---
import { buildHreflang, buildCanonical, getOgLocale, buildPersonSchema } from '@/lib/seo';
import type { Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
  availableLangs?: Lang[];
}

const {
  title,
  description,
  lang,
  path,
  image,
  type = 'website',
  publishedTime,
  jsonLd,
  availableLangs = ['en', 'es', 'pt'],
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = buildCanonical(site, path);
const hreflangEntries = buildHreflang(site, path, lang, availableLangs);
const ogLocale = getOgLocale(lang);
const ogImage = image ?? `${site}/og-default.png`;
const fullTitle = `${title} — Portfolio`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{hreflangEntries.map(({ lang: hl, url }) => (
  <link rel="alternate" hreflang={hl} href={url} />
))}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale} />
{hreflangEntries
  .filter(e => e.lang !== 'x-default' && e.lang !== lang)
  .map(e => (
    <meta property="og:locale:alternate" content={getOgLocale(e.lang as Lang)} />
  ))}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{publishedTime && <meta property="article:published_time" content={publishedTime} />}

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
)}
