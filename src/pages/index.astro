---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/home/Hero.astro";
import TechStack from "@/components/home/TechStack.astro";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import { buildPersonSchema } from "@/lib/seo";

const personSchema = buildPersonSchema(
  "Billy",
  "Senior Full-Stack Developer (.NET / React / Azure)",
  Astro.site?.toString() ?? "",
  [
    "https://github.com/billy-arredondo",
    "https://linkedin.com/in/billy-arredondo",
  ],
);
---

<BaseLayout
  title="Home"
  description="Senior Full-Stack Developer specialising in .NET, React, TypeScript and Azure. Available for freelance projects."
  jsonLd={personSchema}
>
  <Hero />
  <TechStack />
  <FeaturedProjects />
</BaseLayout>
