---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Button } from '@/components/ui/button';
---

<BaseLayout title="404 — Page Not Found" description="The page you were looking for does not exist.">
  <div class="container mx-auto max-w-5xl px-4 py-32 text-center">
    <p class="text-8xl font-bold text-muted-foreground/20 font-mono mb-4">404</p>
    <h1 class="text-2xl font-semibold mb-4">Page not found</h1>
    <p class="text-muted-foreground mb-8">The page you were looking for doesn't exist or has been moved.</p>
    <a href="/"><Button>Go home</Button></a>
  </div>
</BaseLayout>
