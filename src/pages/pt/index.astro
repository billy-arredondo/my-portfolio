---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/home/Hero.astro";
import TechStack from "@/components/home/TechStack.astro";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import { buildPersonSchema } from "@/lib/seo";

const personSchema = buildPersonSchema(
  "Billy Arredondo",
  "Desenvolvedor Full-Stack Sênior (.NET / React / Azure)",
  Astro.site?.toString() ?? "",
  [
    "https://github.com/billy-arredondo",
    "https://linkedin.com/in/billy-arredondo",
  ],
);
---

<BaseLayout
  title="Billy Arredondo"
  description="Desenvolvedor Full-Stack Sênior especializado em .NET, React, TypeScript e Azure. Disponível para projetos freelance."
  jsonLd={personSchema}
>
  <Hero />
  <TechStack />
  <FeaturedProjects />
</BaseLayout>
