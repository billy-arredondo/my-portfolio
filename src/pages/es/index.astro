---
// Mirror of src/pages/index.astro for the /es/ locale
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import TechStack from '@/components/home/TechStack.astro';
import FeaturedProjects from '@/components/home/FeaturedProjects.astro';
import { buildPersonSchema } from '@/lib/seo';

const personSchema = buildPersonSchema(
  'Your Name',
  'Desarrollador Full-Stack Senior (.NET / React / Azure)',
  Astro.site?.toString() ?? '',
  ['https://github.com/yourusername', 'https://linkedin.com/in/yourprofile']
);
---

<BaseLayout
  title="Inicio"
  description="Desarrollador Full-Stack Senior especializado en .NET, React, TypeScript y Azure. Disponible para proyectos freelance."
  jsonLd={personSchema}
>
  <Hero />
  <TechStack />
  <FeaturedProjects />
</BaseLayout>
