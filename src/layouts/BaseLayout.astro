---
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import SEO from "@/components/seo/SEO.astro";
import Header from "@/components/site/Header.astro";
import Footer from "@/components/site/Footer.astro";
import { getLangFromUrl } from "@/i18n/utils";
import type { Lang } from "@/i18n/ui";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  jsonLd?: Record<string, unknown>;
  availableLangs?: Lang[];
}

const {
  title,
  description,
  image,
  type = "website",
  publishedTime,
  jsonLd,
  availableLangs,
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      lang={lang}
      path={path}
      image={image}
      type={type}
      publishedTime={publishedTime}
      jsonLd={jsonLd}
      availableLangs={availableLangs}
    />
    <ClientRouter />
    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle(
          "dark",
          stored === "dark" || (!stored && prefersDark)
        );
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <script is:inline>
      (function () {
        var canvas = document.createElement('canvas');
        canvas.width = 32;
        canvas.height = 32;
        var ctx = canvas.getContext('2d');
        var visible = true;
        var iconScale = 0.8;

        function draw() {
          var dark = document.documentElement.classList.contains('dark');
          var bg = dark ? '#0d0d0d' : '#f5f5f5';
          var fg = dark ? '#f5f5f5' : '#0d0d0d';
          ctx.clearRect(0, 0, 32, 32);
          ctx.fillStyle = bg;
          ctx.beginPath();
          ctx.roundRect(0, 0, 32, 32, 5);
          ctx.fill();
          ctx.save();
          ctx.translate(16, 16);
          ctx.scale(iconScale, iconScale);
          ctx.translate(-16, -16);
          ctx.strokeStyle = fg;
          ctx.lineWidth = 3.5;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.beginPath();
          ctx.moveTo(3.5, 9);
          ctx.lineTo(12, 16);
          ctx.lineTo(3.5, 23);
          ctx.stroke();
          if (visible) {
            ctx.fillStyle = fg;
            ctx.fillRect(15, 21, 14, 2);
          }
          ctx.restore();
          var link = document.querySelector("link[rel='icon']");
          if (link) link.setAttribute('href', canvas.toDataURL());
        }

        draw();
        setInterval(function () { visible = !visible; draw(); }, 550);
        new MutationObserver(draw).observe(document.documentElement, { attributeFilter: ['class'] });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
